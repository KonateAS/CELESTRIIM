# Copy to .env (or .env.local) and set the local PostgreSQL password.
DATABASE_URL="postgresql://celestrium_app:YOUR_PASSWORD@localhost:5432/celestrium?schema=public"
SHADOW_DATABASE_URL="postgresql://celestrium_app:YOUR_PASSWORD@localhost:5432/celestrium_shadow?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# Used once to create the first administrator with `npm run db:seed`.
ADMIN_EMAIL="admin@celestrium.local"
ADMIN_PASSWORD="replace-with-a-unique-password"

# Public origin used to build the XML sitemap. Set this to the verified domain before launch.
SITE_URL="http://localhost:3000"

# Optional local media directory. In production, point this to a persistent mounted volume.
# Uploaded images are served from /uploads/<generated-filename>.webp.
MEDIA_STORAGE_DIR=""
