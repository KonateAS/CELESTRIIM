  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "node --watch server.mjs",
    "build": "node --check server.mjs && node --check lib/site.mjs && node --check js/app.js",
    "start": "node server.mjs",
    "check": "node --check server.mjs && node --check lib/site.mjs && node --check js/app.js",
